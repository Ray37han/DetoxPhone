<?xml version="1.0" encoding="utf-8"?>
<!--
    DetoxAccessibilityService configuration.

    Listens for:
    - TYPE_WINDOW_STATE_CHANGED  → foreground app detection for Engine 1+2+5
    - TYPE_WINDOW_CONTENT_CHANGED → short video node inspection for Engine 4
    - TYPE_VIEW_SCROLLED          → scroll event counting for Engine 3

    canRetrieveWindowContent="true" is required for node tree inspection
    (Engine 4: Reels/Shorts detection).
-->
<accessibility-service
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewScrolled"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:description="@string/detox_accessibility_description"
    android:notificationTimeout="150"
    android:settingsActivity=".MainActivity" />
