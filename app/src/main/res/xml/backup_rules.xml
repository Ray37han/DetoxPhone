<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup rules for Android 11 and below (API 30-).
    Mirror the data-extraction-rules.xml decisions above.
-->
<full-backup-content>
    <include domain="file" path="datastore/"/>
    <include domain="database" path="minimalist_launcher.db"/>
    <exclude domain="database" path="minimalist_launcher.db-wal"/>
    <exclude domain="database" path="minimalist_launcher.db-shm"/>
</full-backup-content>
